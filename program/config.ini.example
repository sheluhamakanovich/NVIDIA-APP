# ========================================
# TELEGRAM PC CONTROL - CONFIG.INI
# ========================================
#
# Этот файл нужен ТОЛЬКО если бот (bot.py) запущен на ДРУГОМ компьютере
# Если бот на ЭТОМ же ПК - удалите этот файл (будет использован localhost)
#
# ========================================

[server]
# URL бота (bot.py)
# 
# Варианты:
#
# 1. Бот на другом ПК в ЛОКАЛЬНОЙ СЕТИ (одна WiFi сеть):
#    url = http://192.168.1.100:8765
#    (замените 192.168.1.100 на локальный IP адрес ПК с ботом)
#
# 2. Бот на другом ПК через ИНТЕРНЕТ (разные сети):
#
#    А) С ngrok (РЕКОМЕНДУЕТСЯ для тестирования):
#       url = https://abc123.ngrok.io
#       (замените на URL из ngrok)
#
#    Б) С port forwarding (для постоянного использования):
#       url = http://123.45.67.89:8765
#       (замените на ваш публичный IP или домен)
#       (требует настройки роутера!)
#
#    В) С VPN (Tailscale):
#       url = http://100.64.1.5:8765
#       (замените на Tailscale IP бота)
#
# 3. Бот на ЭТОМ же ПК (по умолчанию):
#    Удалите этот файл или закомментируйте строку ниже
#    url = http://127.0.0.1:8765
#
# ========================================
# ВАЖНО:
# - 192.168.x.x работает ТОЛЬКО в локальной сети!
# - Для интернета используйте ngrok или port forwarding!
# - Подробнее: REMOTE_CONNECTION_GUIDE.txt
# ========================================

# Раскомментируйте и измените URL:
# url = http://192.168.1.100:8765
